{
  "version": 1,
  "comment": "Shared configuration-schema vectors (issue #11 contract, issue #8 parity). Consumed by src/lib/qcy/config-schema.conformance.test.ts and native/crates/qcy-app/tests/config_conformance.rs. Both implementations must accept the valid payloads with the expected parsed values and reject the invalid ones atomically.",
  "valid": [
    {
      "name": "empty object takes documented defaults",
      "json": {},
      "expect": {
        "theme": "dark",
        "activeProfileId": "music",
        "autoGame": false,
        "autoGameKeyword": "game",
        "customEqCount": 0,
        "customProfilesCount": 0,
        "notifyConnected": true
      }
    },
    {
      "name": "portable payload round-trips",
      "json": {
        "schema": 1,
        "theme": "light",
        "notify": {
          "connected": false,
          "disconnected": true,
          "batteryLow": true,
          "batteryCritical": true,
          "batteryUneven": false,
          "profileSwitch": true
        },
        "customEq": [
          {
            "id": "warm",
            "name": "Warm",
            "kind": "device",
            "official": false,
            "preset": {
              "index": 0,
              "masterGainDb": -1.5,
              "bands": [
                { "freqHz": 31, "gainDb": 2, "q": 1 },
                { "freqHz": 62, "gainDb": 1.5, "q": 1 },
                { "freqHz": 125, "gainDb": 1, "q": 1 },
                { "freqHz": 250, "gainDb": 0.5, "q": 1 },
                { "freqHz": 500, "gainDb": 0, "q": 1 },
                { "freqHz": 1000, "gainDb": 0, "q": 1 },
                { "freqHz": 2000, "gainDb": -0.5, "q": 1 },
                { "freqHz": 4000, "gainDb": -1, "q": 1 },
                { "freqHz": 8000, "gainDb": -1.5, "q": 1 },
                { "freqHz": 16000, "gainDb": -2, "q": 1, "bandType": 1 }
              ]
            }
          }
        ],
        "customProfiles": [
          {
            "id": "commute",
            "name": "Commute",
            "description": "ANC for the bus.",
            "builtin": true,
            "noise": "noisy",
            "ancLevel": 3,
            "transparencyLevel": 2,
            "gameMode": false,
            "eqId": "warm",
            "wearDetection": true
          }
        ],
        "activeProfileId": "commute",
        "autoGame": true,
        "autoGameKeyword": "steam"
      },
      "expect": {
        "theme": "light",
        "activeProfileId": "commute",
        "autoGame": true,
        "autoGameKeyword": "steam",
        "customEqCount": 1,
        "customProfilesCount": 1,
        "notifyConnected": false,
        "importedProfileBuiltin": false
      }
    },
    {
      "name": "unknown extra keys are ignored, never trusted",
      "json": { "theme": "dark", "maliciousAdminFlag": true, "writePolicy": "allow-all" },
      "expect": {
        "theme": "dark",
        "activeProfileId": "music",
        "autoGame": false,
        "autoGameKeyword": "game",
        "customEqCount": 0,
        "customProfilesCount": 0,
        "notifyConnected": true
      }
    },
    {
      "name": "knownDevices persists locally (stored-only)",
      "storedOnly": true,
      "json": { "knownDevices": ["84:AC:60:62:69:DA"] },
      "expect": {
        "theme": "dark",
        "activeProfileId": "music",
        "autoGame": false,
        "autoGameKeyword": "game",
        "customEqCount": 0,
        "customProfilesCount": 0,
        "notifyConnected": true,
        "knownDevicesCount": 1
      }
    },
    {
      "name": "stored payload without knownDevices defaults to empty list",
      "storedOnly": true,
      "json": {},
      "expect": {
        "theme": "dark",
        "activeProfileId": "music",
        "autoGame": false,
        "autoGameKeyword": "game",
        "customEqCount": 0,
        "customProfilesCount": 0,
        "notifyConnected": true,
        "knownDevicesCount": 0
      }
    }
  ],
  "invalid": [
    { "name": "non-object root", "json": [1, 2, 3] },
    { "name": "wrong-typed theme", "json": { "theme": 42 } },
    { "name": "unknown noise mode in profile", "json": {
      "customProfiles": [
        {
          "id": "p", "name": "P", "description": "", "noise": "turbo",
          "ancLevel": 2, "transparencyLevel": 2, "gameMode": false,
          "eqId": "flat", "wearDetection": true
        }
      ]
    }, "expectErrorPathPrefix": "customProfiles[0].noise" },
    { "name": "out-of-range gain", "json": {
      "customEq": [
        {
          "id": "x", "name": "X", "kind": "device", "official": false,
          "preset": { "masterGainDb": 0, "bands": [
            { "freqHz": 31, "gainDb": 99, "q": 1 },
            { "freqHz": 62, "gainDb": 0, "q": 1 },
            { "freqHz": 125, "gainDb": 0, "q": 1 },
            { "freqHz": 250, "gainDb": 0, "q": 1 },
            { "freqHz": 500, "gainDb": 0, "q": 1 },
            { "freqHz": 1000, "gainDb": 0, "q": 1 },
            { "freqHz": 2000, "gainDb": 0, "q": 1 },
            { "freqHz": 4000, "gainDb": 0, "q": 1 },
            { "freqHz": 8000, "gainDb": 0, "q": 1 },
            { "freqHz": 16000, "gainDb": 0, "q": 1 }
          ] }
        }
      ]
    }, "expectErrorPathPrefix": "customEq[0].preset.bands[0].gainDb" },
    { "name": "wrong band count", "json": {
      "customEq": [
        {
          "id": "x", "name": "X", "kind": "device", "official": false,
          "preset": { "masterGainDb": 0, "bands": [ { "freqHz": 31, "gainDb": 0, "q": 1 } ] }
        }
      ]
    }, "expectErrorPathPrefix": "customEq[0].preset.bands" },
    { "name": "too many custom profiles", "json": {
      "customProfiles": "OVER_LIMIT_MARKER"
    }, "expectErrorPathPrefix": "customProfiles", "note": "the consumer constructs 65 valid profiles; the marker is replaced programmatically" },
    { "name": "newer schema refused", "json": { "schema": 2, "theme": "dark" }, "expectErrorPathPrefix": "schema", "storedOnly": true },
    { "name": "knownDevices must be an array", "json": { "knownDevices": "84:AC:60:62:69:DA" }, "expectErrorPathPrefix": "knownDevices", "storedOnly": true },
    { "name": "knownDevices entry must be a string", "json": { "knownDevices": [123] }, "expectErrorPathPrefix": "knownDevices[0]", "storedOnly": true },
    { "name": "knownDevices entry must not be empty", "json": { "knownDevices": ["   "] }, "expectErrorPathPrefix": "knownDevices[0]", "storedOnly": true },
    { "name": "knownDevices entry too long", "json": { "knownDevices": ["84:AC:60:62:69:DA:EXTRA:TOO:LONG:FOR:THE:LIMIT"] }, "expectErrorPathPrefix": "knownDevices[0]", "storedOnly": true },
    { "name": "too many knownDevices", "json": { "knownDevices": ["AA:BB:CC:DD:EE:00", "AA:BB:CC:DD:EE:01", "AA:BB:CC:DD:EE:02", "AA:BB:CC:DD:EE:03", "AA:BB:CC:DD:EE:04", "AA:BB:CC:DD:EE:05", "AA:BB:CC:DD:EE:06", "AA:BB:CC:DD:EE:07", "AA:BB:CC:DD:EE:08", "AA:BB:CC:DD:EE:09", "AA:BB:CC:DD:EE:0A", "AA:BB:CC:DD:EE:0B", "AA:BB:CC:DD:EE:0C", "AA:BB:CC:DD:EE:0D", "AA:BB:CC:DD:EE:0E", "AA:BB:CC:DD:EE:0F", "AA:BB:CC:DD:EE:10"] }, "expectErrorPathPrefix": "knownDevices", "storedOnly": true }
  ]
}
